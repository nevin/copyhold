{
  "name": "copyhold",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "npm run build && node --test \"e2e/**/*.e2e.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "puppeteer": "^25.17.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
