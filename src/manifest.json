{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.2",
  "description": "__MSG_extDescription__",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "contextMenus",
    "idle",
    "offscreen",
    "storage"
  ],
  "minimum_chrome_version": "123",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      }
    },
    "save-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_commandSaveClipboard__"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copyhold@local-extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "default_locale": "en"
}
