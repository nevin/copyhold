{
  "manifest_version": 3,
  "name": "Copyhold",
  "version": "1.0.0",
  "description": "Save, organize, and reuse text from your clipboard.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "idle",
    "offscreen"
  ],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Copyhold",
    "default_popup": "manager.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Y" }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copyhold@local-extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
